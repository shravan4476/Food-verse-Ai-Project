# "hf" = Hugging Face Food-101 classifier, "dummy" = no model download (demo/testing)
FOODVERSE_BACKEND=dummy
FOODVERSE_HF_MODEL=nateraw/food

# LLM reasoning (optional). Without a key the app uses rule-based fallbacks.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Hygiene detector weights (optional YOLO .pt trained on gloves/hairnet/apron/mask)
HYGIENE_YOLO_WEIGHTS=

# UI -> API
FOODVERSE_API_URL=http://localhost:8000
